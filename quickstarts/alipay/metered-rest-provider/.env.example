# Copy to .env for local use, then export it before starting the server.
# Do not commit .env or key files.
# Obtain the current sandbox gateway from the AIPay integration guide linked in README.md.
ALIPAY_GATEWAY_URL=replace-with-current-aipay-sandbox-gateway
ALIPAY_APP_ID=replace-with-sandbox-app-id
ALIPAY_PRIVATE_KEY_FILE=/absolute/path/to/app-private-key.txt
# This must be the Alipay public key, not the application's public key.
ALIPAY_ALIPAY_PUBLIC_KEY_FILE=/absolute/path/to/alipay-public-key.txt
ALIPAY_SELLER_ID=2088xxxxxxxx
ALIPAY_SELLER_NAME=Sandbox merchant
ALIPAY_SERVICE_ID=replace-with-registered-service-id
ALIPAY_GOODS_NAME=ACT sandbox resource
ALIPAY_RESOURCE_ID=act-quickstart-resource-v1
ALIPAY_AMOUNT=0.01
ALIPAY_CURRENCY=CNY
ALIPAY_PORT=8080

# Optional for third-party application calls.
# ALIPAY_APP_AUTH_TOKEN=replace-with-app-auth-token

# Optional local ACT Demo observer. It receives sanitized state only.
# ACT_DEMO_BRIDGE_URL=http://127.0.0.1:4173/events
# ACT_DEMO_VALIDATION_ID=E2E-YYYYMMDD-NNN
