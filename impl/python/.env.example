# ========================================
# ACT 协议演示 - 环境配置示例
# ========================================
# 复制此文件为 .env 并填入你的实际配置
# cp .env.example .env
# ========================================

# ========================================
# 模型提供商选择
# ========================================
# 选择使用的模型提供商: openai | dashscope
MODEL_PROVIDER=dashscope

# ========================================
# OpenAI 配置 (MODEL_PROVIDER=openai 时使用)
# ========================================
# OpenAI API Key (从 https://platform.openai.com/api-keys 获取)
# OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI 模型选择 (可选，默认 gpt-3.5-turbo)
# 可选值: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# OPENAI_MODEL=gpt-3.5-turbo

# OpenAI 代理地址 (可选，使用第三方代理时设置)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ========================================
# 阿里云 DashScope 配置 (MODEL_PROVIDER=dashscope 时使用)
# ========================================
# DashScope API Key (从 https://dashscope.console.aliyun.com/api-key 获取)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# DashScope 模型选择 (可选，默认 qwen-turbo)
# 通义千问系列:
#   - qwen-turbo: 速度快、成本低，适合大多数场景 (推荐)
#   - qwen-plus: 性能均衡，能力较强
#   - qwen-max: 最强能力版，适合复杂任务
#   - qwen-long: 支持长文本 (百万 token)
#   - qwen-coder-plus: 代码生成优化
#   - qwen-math-plus: 数学推理优化
# DeepSeek 系列:
#   - deepseek-r1: 开源推理模型，逻辑能力强
#   - deepseek-v3: 开源通用模型，性价比高
#
# DASHSCOPE_MODEL=qwen-turbo

# ========================================
# Agent 基础配置
# ========================================
AGENT_NAME=小购助手
AGENT_DESCRIPTION=电商购物助手

# ========================================
# 应用配置
# ========================================
APP_TITLE=电商购物助手
APP_ICON=🛒
APP_LAYOUT=centered

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=INFO
LOG_FILE=ecommerce_agent.log

# ========================================
# 使用说明
# ========================================
# 1. 获取 API Key:
#    - OpenAI: https://platform.openai.com/api-keys
#    - DashScope: https://dashscope.console.aliyun.com/api-key
#
# 2. 建议优先使用 DashScope (阿里系模型):
#    - 国内访问稳定，无需代理
#    - 通义千问中文理解能力强
#    - 成本相对较低
#    - 最新支持 DeepSeek 系列模型
#
# 3. 运行应用:
#    cd impl/python
#    pip install -r requirements.txt
#    streamlit run ui/app.py
#
# 4. 快速测试:
#    python -c "
#    from assistant_agent.agent import create_assistant_agent
#    agent = create_assistant_agent(
#        api_key='sk-your-key',
#        model='qwen-turbo',
#        provider='dashscope'
#    )
#    print(agent.chat('你好'))
#    "
# ========================================
