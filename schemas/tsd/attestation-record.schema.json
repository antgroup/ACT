{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/tsd/attestation-record.schema.json",
  "title": "Attestation Record",
  "description": "ACT 协议存证记录（TSD-ATT-OFF）的 JSON Schema 定义",
  "type": "object",
  "required": ["record_id", "event_id", "event_digest", "attestation_time", "attestation_provider_id", "provider_signature"],
  "properties": {
    "record_id": {
      "type": "string",
      "description": "存证记录唯一标识符"
    },
    "event_id": {
      "type": "string",
      "description": "关联的存证事件标识"
    },
    "event_digest": {
      "type": "string",
      "description": "存证事件摘要"
    },
    "attestation_time": {
      "type": "string",
      "format": "date-time",
      "description": "存证时间戳（ISO 8601 UTC）"
    },
    "attestation_provider_id": {
      "type": "string",
      "description": "存证服务方标识"
    },
    "anchor_id": {
      "type": "string",
      "description": "关联的链上存证锚标识"
    },
    "merkle_proof": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": { "type": "string", "enum": ["left", "right"] },
          "hash": { "type": "string" }
        }
      },
      "description": "Merkle 证明路径"
    },
    "provider_signature": {
      "type": "string",
      "description": "存证服务方签名"
    }
  }
}