{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/tsd/dispute-schema.schema.json",
  "title": "Dispute (TSD-ATT-DSP)",
  "description": "ACT 协议争议处理（TSD-ATT-DSP）的 JSON Schema 定义",
  "type": "object",
  "required": [
    "dispute_id",
    "dispute_type",
    "filing_party_id",
    "related_party_id",
    "trade_reference",
    "dispute_reason",
    "evidence_list",
    "filed_at"
  ],
  "properties": {
    "dispute_id": {
      "type": "string",
      "description": "争议案件唯一标识"
    },
    "dispute_type": {
      "type": "string",
      "enum": ["UNAUTHORIZED_TRANSACTION", "FULFILLMENT_DISPUTE", "AMOUNT_DISPUTE", "IAC_DISPUTE"],
      "description": "争议类型",
      "examples": [
        "UNAUTHORIZED_TRANSACTION",
        "FULFILLMENT_DISPUTE",
        "AMOUNT_DISPUTE",
        "IAC_DISPUTE"
      ]
    },
    "filing_party_id": {
      "type": "string",
      "description": "争议提交方身份标识"
    },
    "related_party_id": {
      "type": "string",
      "description": "争议相关方身份标识"
    },
    "trade_reference": {
      "type": "object",
      "description": "交易参考信息",
      "required": ["merchant_order_id"],
      "properties": {
        "merchant_order_id": {
          "type": "string",
          "description": "商户订单号"
        },
        "trade_no": {
          "type": "string",
          "description": "交易流水号"
        },
        "delegation_id": {
          "type": "string",
          "description": "关联的委托标识"
        },
        "intent_id": {
          "type": "string",
          "description": "关联的意图标识"
        },
        "total_amount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "description": "交易金额"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "币种"
        }
      }
    },
    "dispute_reason": {
      "type": "object",
      "description": "争议原因详情",
      "required": ["summary", "description"],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 200,
          "description": "争议摘要"
        },
        "description": {
          "type": "string",
          "description": "争议详细描述"
        },
        "expected_resolution": {
          "type": "string",
          "description": "期望的解决方式"
        }
      }
    },
    "evidence_list": {
      "type": "array",
      "description": "证据列表",
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_type", "attestation_ids"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "description": "证据唯一标识"
          },
          "evidence_type": {
            "type": "string",
            "enum": ["ATTESTATION", "DOCUMENT", "LOG", "OTHER"],
            "description": "证据类型"
          },
          "attestation_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "关联的存证事件 ID 列表"
          },
          "file_url": {
            "type": "string",
            "format": "uri",
            "description": "文件 URL（证据类型为 DOCUMENT 时提供）"
          },
          "description": {
            "type": "string",
            "description": "证据描述"
          }
        }
      }
    },
    "filed_at": {
      "type": "string",
      "format": "date-time",
      "description": "提交时间（ISO 8601 UTC）"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING_RESEARCH", "IN_MEDATION", "AWAITING_DECISION", "DECIDED", "CLOSED"],
      "description": "争议处理状态"
    },
    "signature": {
      "type": "string",
      "description": "争议提交的数字签名"
    }
  }
}