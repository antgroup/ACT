{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/add/intent-authorization-credential.schema.json",
  "title": "Intent Authorization Credential (IAC)",
  "description": "ACT 协议意图授权凭证（ADD-IAC-ISS）的 JSON Schema 定义。本版本将 W3C VC-JWT 作为推荐实现方式之一，但并非唯一封装格式",
  "type": "object",
  "required": ["iss", "sub", "jti", "iat", "exp", "vc"],
  "properties": {
    "iss": {
      "type": "string",
      "description": "签发方（委托人）DID 标识"
    },
    "sub": {
      "type": "string",
      "description": "受托方（智能体）DID 标识"
    },
    "jti": {
      "type": "string",
      "description": "凭证唯一标识，等于 delegation_id"
    },
    "iat": {
      "type": "integer",
      "description": "签发时间（Unix 时间戳）"
    },
    "exp": {
      "type": "integer",
      "description": "过期时间（Unix 时间戳）"
    },
    "vc": {
      "type": "object",
      "required": ["type", "credentialSubject"],
      "properties": {
        "type": {
          "type": "array",
          "items": { "type": "string" },
          "contains": { "const": "ACTIntentAuthorization" },
          "description": "凭证类型列表，须包含 ACTIntentAuthorization"
        },
        "credentialSubject": {
          "$ref": "https://specs.actprotocol.org/schemas/add/iac-payload.schema.json"
        }
      }
    }
  }
}
