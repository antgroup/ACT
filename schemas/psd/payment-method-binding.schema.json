{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/psd/payment-method-binding.schema.json",
  "title": "Payment Method Binding (PSD-PMT-BND)",
  "description": "ACT 协议支付方式绑定流程（PSD-PMT-BND）的 JSON Schema 定义，包含绑定请求与绑定响应报文结构",
  "definitions": {
    "BindingRequest": {
      "type": "object",
      "description": "委托人向 PSP 发起的支付方式绑定请求",
      "required": [
        "request_id",
        "principal_id",
        "agent_id",
        "payment_account_ref",
        "timestamp"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "本次请求的全局唯一标识"
        },
        "principal_id": {
          "type": "string",
          "description": "委托人身份标识"
        },
        "agent_id": {
          "type": "string",
          "description": "受托智能体身份标识"
        },
        "payment_account_ref": {
          "type": "string",
          "description": "委托人支付账户引用（不直接传递原始账户信息，由 PSP 侧完成账户解析）"
        },
        "token_constraints": {
          "type": "object",
          "description": "支付标记约束参数（可选）",
          "properties": {
            "max_amount_per_transaction": {
              "type": "number",
              "minimum": 0,
              "description": "单笔金额上限"
            },
            "validity_period": {
              "type": "object",
              "description": "标记有效期",
              "properties": {
                "start_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "生效时间"
                },
                "end_time": {
                  "type": "string",
                  "format": "date-time",
                  "description": "失效时间"
                }
              }
            },
            "allowed_merchants": {
              "type": "array",
              "items": { "type": "string" },
              "description": "允许使用的商户范围"
            }
          }
        },
        "authentication_method": {
          "type": "string",
          "enum": ["FACE_RECOGNITION", "FINGERPRINT", "PASSWORD", "OTP"],
          "description": "委托人核身方式"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "请求时间戳（ISO 8601 格式）"
        }
      }
    },
    "BindingResponse": {
      "type": "object",
      "description": "PSP 返回给委托人的支付方式绑定结果",
      "required": [
        "request_id",
        "status",
        "timestamp"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "回传本次请求的全局唯一标识"
        },
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILED"],
          "description": "绑定结果状态"
        },
        "payment_token": {
          "type": "string",
          "description": "PSP 生成的支付标记（绑定成功时返回）"
        },
        "token_expiry": {
          "type": "string",
          "format": "date-time",
          "description": "支付标记过期时间（绑定成功时返回）"
        },
        "bound_agent_id": {
          "type": "string",
          "description": "支付标记绑定的智能体身份标识（绑定成功时返回）"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "响应时间戳（ISO 8601 格式）"
        },
        "error": {
          "type": "object",
          "description": "错误详情，仅在绑定失败时返回",
          "properties": {
            "error_code": {
              "type": "string",
              "enum": [
                "AUTH_FAILED",
                "AGENT_NOT_REGISTERED",
                "ACCOUNT_LIMIT_EXCEEDED",
                "ACCOUNT_INVALID",
                "SYSTEM_ERROR"
              ],
              "description": "错误语义类别编码"
            },
            "error_message": {
              "type": "string",
              "description": "错误详情描述"
            }
          }
        }
      }
    }
  }
}