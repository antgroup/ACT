{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/psd/instant-payment-payload.schema.json",
  "title": "Instant Payment Payload (PSD-PAY-INS)",
  "description": "ACT 协议用户即时支付（PSD-PAY-INS）的 JSON Schema 定义",
  "type": "object",
  "required": [
    "request_id",
    "buyer_agent_id",
    "merchant_id",
    "merchant_order_id",
    "cart_snapshot_hash",
    "payment_token",
    "amount",
    "currency",
    "timestamp"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "请求全局唯一标识，用于防重放"
    },
    "buyer_agent_id": {
      "type": "string",
      "description": "买方智能体身份标识"
    },
    "merchant_id": {
      "type": "string",
      "description": "商户身份标识"
    },
    "merchant_order_id": {
      "type": "string",
      "description": "商户侧订单号，来自 CID-CART-CFM"
    },
    "cart_snapshot_hash": {
      "type": "string",
      "description": "购物车快照摘要，用于验证支付金额与购物车一致性"
    },
    "payment_token": {
      "type": "string",
      "description": "支付标记，来自 PSD-PMT-BND 绑定结果"
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "支付金额（字符串格式）"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "币种（ISO 4217）"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "请求时间戳（ISO 8601 UTC）"
    },
    "description": {
      "type": "string",
      "description": "支付描述"
    },
    "reference_info": {
      "type": "object",
      "description": "参考信息",
      "properties": {
        "cid_delegation_id": {
          "type": "string",
          "description": "关联的委托标识（如有）"
        },
        "cid_intent_id": {
          "type": "string",
          "description": "关联的意图标识"
        }
      }
    },
    "signature": {
      "type": "string",
      "description": "买方智能体对请求关键要素的签名"
    },
    "signature_algorithm": {
      "type": "string",
      "description": "签名算法标识"
    }
  }
}