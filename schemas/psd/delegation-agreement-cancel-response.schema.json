{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/psd/delegation-agreement-cancel-response.schema.json",
  "title": "Delegation Agreement Cancel Response (PSD-PAY-DEL-CANCEL-RESP)",
  "description": "ACT 协议委托协议解约响应（PSD-PAY-DEL-CANCEL-RESP）的 JSON Schema 定义。PSP 返回解约处理结果。",
  "type": "object",
  "required": [
    "request_id",
    "agreement_no",
    "status",
    "timestamp"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "对应的请求全局唯一标识"
    },
    "agreement_no": {
      "type": "string",
      "description": "委托协议号"
    },
    "external_agreement_no": {
      "type": "string",
      "description": "外部协议号（回传）"
    },
    "status": {
      "type": "string",
      "enum": ["CANCELLED", "CANCEL_FAILED"],
      "description": "解约状态：CANCELLED-解约成功，CANCEL_FAILED-解约失败"
    },
    "cancel_time": {
      "type": "string",
      "format": "date-time",
      "description": "解约生效时间（ISO 8601 UTC）"
    },
    "error_code": {
      "type": "string",
      "description": "错误码，解约失败时返回"
    },
    "error_message": {
      "type": "string",
      "description": "错误描述信息"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "响应时间戳（ISO 8601 UTC）"
    }
  }
}
