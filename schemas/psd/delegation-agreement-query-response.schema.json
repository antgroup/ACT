{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/psd/delegation-agreement-query-response.schema.json",
  "title": "Delegation Agreement Query Response (PSD-PAY-DEL-QUERY-RESP)",
  "description": "ACT 协议委托协议查询响应（PSD-PAY-DEL-QUERY-RESP）的 JSON Schema 定义。返回查询到的委托协议详情列表。",
  "type": "object",
  "required": [
    "request_id",
    "agreements",
    "timestamp"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "对应的请求全局唯一标识"
    },
    "agreements": {
      "type": "array",
      "description": "查询到的委托协议列表",
      "items": {
        "type": "object",
        "required": [
          "agreement_no",
          "status",
          "principal_id",
          "agent_id",
          "agreement_type",
          "sign_time"
        ],
        "properties": {
          "agreement_no": {
            "type": "string",
            "description": "PSP 生成的委托协议号"
          },
          "external_agreement_no": {
            "type": "string",
            "description": "外部协议号"
          },
          "status": {
            "type": "string",
            "enum": ["SIGNED", "UNSIGNED", "SUSPENDED", "REVOKED", "EXPIRED"],
            "description": "协议状态：SIGNED-已签约，UNSIGNED-未签约/签约中，SUSPENDED-已暂停，REVOKED-已解约，EXPIRED-已过期"
          },
          "principal_id": {
            "type": "string",
            "description": "委托人身份标识（DID）"
          },
          "agent_id": {
            "type": "string",
            "description": "受托智能体身份标识（DID）"
          },
          "agreement_type": {
            "type": "string",
            "enum": ["DELEGATION_SPECIFIED", "DELEGATION_GENERAL"],
            "description": "委托协议类型"
          },
          "sign_time": {
            "type": "string",
            "format": "date-time",
            "description": "签约时间（ISO 8601 UTC）"
          },
          "validity": {
            "type": "object",
            "description": "协议有效期",
            "properties": {
              "start_time": {
                "type": "string",
                "format": "date-time",
                "description": "协议生效时间（ISO 8601 UTC）"
              },
              "end_time": {
                "type": "string",
                "format": "date-time",
                "description": "协议过期时间（ISO 8601 UTC）"
              }
            }
          },
          "single_amount_limit": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "description": "单笔扣款金额上限"
          },
          "total_amount_limit": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "description": "协议累计扣款金额上限"
          },
          "deducted_amount": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "description": "已累计扣款金额"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "金额币种（ISO 4217）"
          },
          "allowed_payment_methods": {
            "type": "array",
            "items": { "type": "string" },
            "description": "允许的支付方式标识符列表"
          },
          "allowed_merchants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "允许的商户标识符列表（定向委托场景）"
          },
          "last_deduct_time": {
            "type": "string",
            "format": "date-time",
            "description": "最近一次扣款时间（ISO 8601 UTC）"
          },
          "period_rule": {
            "type": "object",
            "description": "周期扣款规则",
            "properties": {
              "period_type": {
                "type": "string",
                "enum": ["DAY", "WEEK", "MONTH", "YEAR"],
                "description": "扣款周期类型"
              },
              "period": {
                "type": "integer",
                "minimum": 1,
                "description": "扣款周期数"
              },
              "execution_time": {
                "type": "string",
                "description": "扣款执行时间"
              },
              "single_amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "description": "单次扣款金额上限"
              }
            }
          },
          "cancel_time": {
            "type": "string",
            "format": "date-time",
            "description": "解约时间（ISO 8601 UTC），仅 REVOKED 状态时有值"
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "响应时间戳（ISO 8601 UTC）"
    }
  }
}
