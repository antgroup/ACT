{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/cid/cart-confirmation.schema.json",
  "title": "Cart Confirmation (CID-CART-CFM)",
  "description": "ACT 协议购物车确认（CID-CART-CFM）的 JSON Schema 定义",
  "type": "object",
  "required": [
    "request_id",
    "intent_id",
    "delegation_id",
    "buyer_agent_id",
    "merchant_id",
    "merchant_order_id",
    "cart_snapshot",
    "total_amount",
    "currency",
    "timestamp"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "请求全局唯一标识，用于防重放"
    },
    "intent_id": {
      "type": "string",
      "description": "意图标识"
    },
    "delegation_id": {
      "type": "string",
      "description": "委托标识，委托支付场景下包含，即时支付场景下可省略"
    },
    "buyer_agent_id": {
      "type": "string",
      "description": "买方智能体身份标识"
    },
    "merchant_id": {
      "type": "string",
      "description": "商户身份标识"
    },
    "merchant_order_id": {
      "type": "string",
      "description": "商户侧生成的订单交易号"
    },
    "cart_snapshot": {
      "type": "object",
      "description": "购物车快照，包含本次确认的购买标的信息",
      "required": ["items", "snapshot_hash"],
      "properties": {
        "items": {
          "type": "array",
          "description": "商品/服务明细列表",
          "items": {
            "type": "object",
            "required": ["product_id", "product_name", "price", "quantity"],
            "properties": {
              "product_id": {
                "type": "string",
                "description": "商品标识"
              },
              "product_name": {
                "type": "string",
                "description": "商品名称"
              },
              "category": {
                "type": "string",
                "description": "商品品类"
              },
              "price": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "description": "单价（字符串格式）"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "description": "数量"
              },
              "subtotal": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "description": "小计金额"
              }
            }
          }
        },
        "snapshot_hash": {
          "type": "string",
          "description": "购物车快照的数字摘要（SHA-256）"
        }
      }
    },
    "total_amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "实际总金额（字符串格式，避免浮点精度问题）"
    },
    "shipping_fee": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "配送费用（可选）"
    },
    "discount_amount": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "优惠金额（可选）"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "货币单位（ISO 4217）"
    },
    "delivery_requirements": {
      "type": "object",
      "description": "履约要求",
      "properties": {
        "delivery_address": {
          "type": "string",
          "description": "配送地址"
        },
        "estimated_delivery_time": {
          "type": "string",
          "format": "date-time",
          "description": "预计送达时间"
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "确认时间戳（ISO 8601 UTC）"
    },
    "reference_payment_info": {
      "type": "object",
      "description": "参考支付信息，用于支付能力协商",
      "properties": {
        "payment_method": {
          "type": "string",
          "description": "选定的支付方式标识符"
        },
        "psp_id": {
          "type": "string",
          "description": "支付服务方标识"
        },
        "psp_endpoint": {
          "type": "string",
          "format": "uri",
          "description": "PSP 服务端点"
        }
      }
    },
    "signature": {
      "type": "string",
      "description": "买方智能体对请求关键要素的数字签名"
    }
  }
}