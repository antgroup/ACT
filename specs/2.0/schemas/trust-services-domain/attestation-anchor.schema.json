{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/schemas/tsd/attestation-anchor.schema.json",
  "title": "Attestation Anchor",
  "description": "ACT 协议链上存证锚（TSD-ATT-OCA）的 JSON Schema 定义",
  "type": "object",
  "required": ["anchor_id", "chain_id", "block_height", "block_hash", "merkle_root", "record_count", "anchor_time", "attestation_provider_id"],
  "properties": {
    "anchor_id": {
      "type": "string",
      "description": "存证锚唯一标识符"
    },
    "chain_id": {
      "type": "string",
      "description": "ACT Trust Chain 网络标识"
    },
    "block_height": {
      "type": "integer",
      "minimum": 0,
      "description": "链上区块高度"
    },
    "block_hash": {
      "type": "string",
      "description": "链上区块哈希"
    },
    "merkle_root": {
      "type": "string",
      "description": "本批次存证记录的 Merkle 根哈希"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1,
      "description": "本批次包含的存证记录数量"
    },
    "anchor_time": {
      "type": "string",
      "format": "date-time",
      "description": "存证锚生成时间（ISO 8601 UTC）"
    },
    "attestation_provider_id": {
      "type": "string",
      "description": "生成该锚的存证服务方标识"
    }
  }
}