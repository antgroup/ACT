{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.actprotocol.org/2.1-candidate.1/a402/payment-needed.schema.json",
  "title": "ACT A402 Payment-Needed Candidate Payload",
  "$comment": "Decoded Header payload; Candidate Working Draft / Non-normative",
  "type": "object",
  "required": ["protocol", "method"],
  "properties": {
    "protocol": {
      "type": "object",
      "required": [
        "method_id", "method_version", "out_trade_no", "amount", "currency",
        "resource_id", "pay_before", "seller_unique_id", "request_method",
        "request_fingerprint", "replay_window_seconds", "signer_id",
        "signature_content", "signature_type"
      ],
      "properties": {
        "method_id": { "$ref": "common.schema.json#/$defs/methodId" },
        "method_version": { "$ref": "common.schema.json#/$defs/methodVersion" },
        "out_trade_no": { "$ref": "common.schema.json#/$defs/identifier" },
        "amount": { "$ref": "common.schema.json#/$defs/amount" },
        "currency": { "$ref": "common.schema.json#/$defs/currency" },
        "resource_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "pay_before": { "$ref": "common.schema.json#/$defs/dateTime" },
        "seller_unique_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "buyer_unique_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "request_method": { "$ref": "common.schema.json#/$defs/httpMethod" },
        "request_fingerprint": { "$ref": "common.schema.json#/$defs/requestFingerprint" },
        "idempotency_key": { "$ref": "common.schema.json#/$defs/identifier" },
        "replay_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2592000
        },
        "commerce_confirmation": { "$ref": "common.schema.json#/$defs/commerceConfirmation" },
        "signer_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "signature_content": { "$ref": "common.schema.json#/$defs/base64url" },
        "signature_type": { "$ref": "common.schema.json#/$defs/signatureType" }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
