{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assertion-catalog.schema.json",
  "title": "ACT 2.1 Candidate Assertion Catalog",
  "type": "object",
  "required": [
    "catalog_version",
    "protocol_version",
    "status",
    "normative",
    "assertions"
  ],
  "properties": {
    "catalog_version": {
      "type": "string"
    },
    "protocol_version": {
      "const": "2.1-candidate"
    },
    "status": {
      "const": "candidate-working-draft"
    },
    "normative": {
      "const": false
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "source",
          "applies_to",
          "statement",
          "test_level",
          "preconditions",
          "inputs",
          "expected_output",
          "executable_check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-CAND-[0-9]{3}$"
          },
          "status": {
            "const": "candidate"
          },
          "source": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "test_level": {
            "enum": [
              "documentation",
              "unit",
              "integration",
              "end-to-end"
            ]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "expected_output": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "executable_check": {
            "type": [
              "string",
              "null"
            ]
          },
          "pending_decision": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
