{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "ACT A402 Candidate Common Definitions",
  "$comment": "Candidate Working Draft / Non-normative",
  "$defs": {
    "methodId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:[a-z0-9][a-z0-9._/-]*$",
      "minLength": 3,
      "maxLength": 160
    },
    "methodVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(?:\\.[0-9]{1,18})?$",
      "maxLength": 80
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 1
    },
    "requestFingerprint": {
      "type": "string",
      "pattern": "^sha-256:[A-Za-z0-9_-]{43}$"
    },
    "httpMethod": {
      "type": "string",
      "pattern": "^[A-Z]+$",
      "maxLength": 32
    },
    "signatureType": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]{2,32}$"
    },
    "commerceConfirmation": {
      "type": "object",
      "required": ["confirmation_id", "confirmation_digest"],
      "properties": {
        "confirmation_id": { "$ref": "#/$defs/identifier" },
        "confirmation_digest": { "$ref": "#/$defs/requestFingerprint" },
        "confirmation_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["type", "digest"],
      "properties": {
        "type": {
          "enum": ["PAYMENT", "VALIDATION", "DELIVERY", "FULFILLMENT", "RECEIPT"]
        },
        "digest": { "$ref": "#/$defs/requestFingerprint" },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    }
  }
}
