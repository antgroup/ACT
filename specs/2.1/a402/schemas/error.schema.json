{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "ACT A402 Candidate Error",
  "$comment": "Candidate Working Draft / Non-normative",
  "type": "object",
  "required": ["error_id", "category", "phase", "retryability", "valid_next_actions", "message"],
  "properties": {
    "error_id": {
      "type": "string",
      "pattern": "^ACT-A402-[A-Z0-9_]+$",
      "maxLength": 96
    },
    "category": {
      "enum": [
        "SIGNATURE_VALIDATION", "REQUEST_PARAMETER", "PROTOCOL_METHOD",
        "PARTICIPANT_IDENTITY", "LIMIT_ASSET", "AUTHORIZATION_RISK",
        "TRANSACTION_STATE", "REFUND", "FULFILLMENT_RECEIPT",
        "PAYMENT_PROOF_VALIDATION", "SYSTEM"
      ]
    },
    "phase": {
      "enum": ["REQUIREMENT", "AUTHORIZATION", "PAYMENT", "PROOF_VALIDATION", "DELIVERY", "FULFILLMENT", "EVIDENCE"]
    },
    "retryability": {
      "enum": ["NEVER", "AFTER_CORRECTION", "AFTER_AUTHORIZATION", "RETRYABLE", "QUERY_FIRST", "TERMINAL"]
    },
    "valid_next_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CORRECT_REQUEST", "RENEGOTIATE_METHOD", "REAUTHORIZE",
          "CHANGE_PAYMENT_TOOL", "QUERY_PAYMENT_STATUS", "OBTAIN_NEW_PROOF",
          "RETRY_VALIDATION", "RETRY_DELIVERY", "RETRY_FULFILLMENT",
          "RETURN_PRIOR_RESULT", "CREATE_NEW_REQUIREMENT", "SWITCH_COUNTERPARTY",
          "ESCALATE", "ABORT"
        ]
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
