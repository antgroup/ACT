{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-binding-manifest.schema.json",
  "title": "ACT 2.1 A402 Implementation Workflow Binding Manifest",
  "$comment": "Implementation Artifact / Non-normative",
  "type": "object",
  "required": ["binding_id", "binding_version", "covers", "inputs", "observable_outcomes", "evidence", "redaction"],
  "properties": {
    "binding_id": { "$ref": "common.schema.json#/$defs/methodId" },
    "binding_version": { "$ref": "common.schema.json#/$defs/methodVersion" },
    "covers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["PAYMENT_REQUIREMENT", "AUTHORIZATION", "PAYMENT", "ORIGINAL_REQUEST_RETRY", "PROOF_VALIDATION", "DELIVERY", "FULFILLMENT", "EVIDENCE"]
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observable_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "redaction": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
